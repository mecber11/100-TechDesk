// SIGECO: modelo físico obtenido de PostgreSQL. Solo estructura, sin datos.
// Una instalación y base de datos por empresa. cfg.configuracion_empresa tiene una sola fila (id=1).

Table acad.attendance {
  attendance_id bigint [not null, pk]
  session_id integer [not null]
  enrollment_id integer [not null]
  status varchar(16) [not null]
  marked_at timestamptz [not null]
  marked_by_user_id integer
  indexes {
    (session_id, enrollment_id) [unique]
  }
}

Table acad.certificate_templates {
  template_id integer [not null, pk]
  name varchar(80) [not null]
  course_type_id smallint
  html_layout text
  is_active boolean [not null]
}

Table acad.certificates {
  certificate_id integer [not null, pk]
  enrollment_id integer [not null, unique]
  template_id integer
  certificate_code varchar(40) [not null, unique]
  issued_on date [not null]
  hours_accredited numeric(6,1) [not null]
  pdu_hours numeric(6,1)
  file_url varchar(400)
  public_verify_url varchar(400)
  revoked_at timestamptz
  revoke_reason varchar(200)
}

Table acad.course_editions {
  edition_id integer [not null, pk]
  course_id integer [not null]
  edition_code varchar(40) [not null, unique]
  modality_id smallint [not null]
  campus_id integer
  classroom_id integer
  starts_on date [not null]
  ends_on date [not null]
  enrollment_opens_on date
  enrollment_closes_on date
  price_pen numeric(12,2) [not null]
  max_seats integer [not null]
  status varchar(20) [not null]
  meeting_url varchar(400)
  featured_on_home boolean [not null]
  notes varchar(400)
  created_at timestamptz [not null]
}

Table acad.edition_instructors {
  edition_id integer [not null]
  instructor_id integer [not null]
  is_lead boolean [not null]
  indexes {
    (edition_id, instructor_id) [pk]
  }
}

Table acad.edition_sessions {
  session_id integer [not null, pk]
  edition_id integer [not null]
  session_number integer [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  topic varchar(200)
  classroom_id integer
  meeting_url varchar(400)
  indexes {
    (edition_id, session_number) [unique]
  }
}

Table acad.enrollment_status_history {
  history_id bigint [not null, pk]
  enrollment_id integer [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_at timestamptz [not null]
  changed_by_user_id integer
  reason varchar(300)
}

Table acad.enrollments {
  enrollment_id integer [not null, pk]
  enrollment_code varchar(30) [not null, unique]
  student_id integer [not null]
  edition_id integer [not null]
  organization_id integer
  agreement_id integer
  status varchar(20) [not null]
  enrolled_at timestamptz [not null]
  confirmed_at timestamptz
  completed_at timestamptz
  attendance_percent numeric(5,2)
  final_score numeric(5,2)
  origin varchar(20) [not null]
  sales_user_id integer
  notes varchar(400)
  indexes {
    (student_id, edition_id) [unique]
  }
}

Table acad.evaluations {
  evaluation_id integer [not null, pk]
  enrollment_id integer [not null]
  title varchar(120) [not null]
  score numeric(5,2) [not null]
  max_score numeric(5,2) [not null]
  evaluated_at date [not null]
}

Table acad.students {
  student_id integer [not null, pk]
  document_type_id smallint [not null]
  document_number varchar(20) [not null]
  first_name varchar(80) [not null]
  last_name varchar(80) [not null]
  email citext [not null, unique]
  phone varchar(20)
  profession varchar(120)
  specialty varchar(120)
  city varchar(80)
  department varchar(80)
  organization_id integer
  user_id integer
  marketing_opt_in boolean [not null]
  created_at timestamptz [not null]
  is_active boolean [not null]
  indexes {
    (document_type_id, document_number) [unique]
  }
}

Table anl.audit_logs {
  audit_log_id bigint [not null, pk]
  actor_user_id integer
  action varchar(40) [not null]
  entity varchar(60) [not null]
  entity_id varchar(40)
  before_json jsonb
  after_json jsonb
  ip_address varchar(45)
  user_agent varchar(300)
  created_at timestamptz [not null]
}

Table anl.kpi_definitions {
  kpi_id integer [not null, pk]
  code varchar(30) [not null, unique]
  name varchar(160) [not null]
  unit varchar(20) [not null]
  period varchar(16) [not null]
  formula_note varchar(400)
  target_value numeric(18,4)
  is_active boolean [not null]
}

Table anl.kpi_snapshots {
  snapshot_id bigint [not null, pk]
  kpi_id integer [not null]
  captured_at timestamptz [not null]
  dimension varchar(80)
  value numeric(18,4) [not null]
}

Table anl.vw_complaint_sla {
  complaint_id integer
  ticket_code varchar(20)
  kind varchar(16)
  status varchar(20)
  created_at timestamptz
  due_at date
  answered_at timestamptz
  met_sla integer
}

Table anl.vw_edition_seats {
  edition_id integer
  edition_code varchar(40)
  course_title varchar(220)
  max_seats integer
  occupied_seats bigint
  free_seats bigint
  status varchar(20)
  starts_on date
  price_pen numeric(12,2)
}

Table anl.vw_enrollment_funnel {
  day date
  status varchar(20)
  origin varchar(20)
  qty bigint
}

Table anl.vw_lead_funnel {
  status varchar(20)
  qty bigint
}

Table anl.vw_revenue_by_month {
  month_start date
  collected_pen numeric
}

Table anl.vw_student_history {
  student_id integer
  document_number varchar(20)
  first_name varchar(80)
  last_name varchar(80)
  email citext
  enrollment_code varchar(30)
  status varchar(20)
  enrolled_at timestamptz
  origin varchar(20)
  edition_code varchar(40)
  course_title varchar(220)
  attendance_percent numeric(5,2)
  final_score numeric(5,2)
  certificate_code varchar(40)
}

Table cat.accreditation_bodies {
  body_id integer [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(160) [not null]
  logo_url varchar(400)
}

Table cat.course_accreditations {
  course_id integer [not null]
  body_id integer [not null]
  credential_note varchar(200)
  indexes {
    (course_id, body_id) [pk]
  }
}

Table cat.course_areas {
  course_id integer [not null]
  area_id integer [not null]
  indexes {
    (course_id, area_id) [pk]
  }
}

Table cat.course_modules {
  module_id integer [not null, pk]
  course_id integer [not null]
  sort_order integer [not null]
  title varchar(200) [not null]
  hours numeric(5,1)
}

Table cat.course_prerequisites {
  course_id integer [not null]
  prerequisite_course_id integer [not null]
  indexes {
    (course_id, prerequisite_course_id) [pk]
  }
}

Table cat.course_types {
  course_type_id smallint [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(80) [not null]
}

Table cat.courses {
  course_id integer [not null, pk]
  code varchar(30) [not null, unique]
  slug varchar(180) [not null, unique]
  title varchar(220) [not null]
  short_description varchar(400)
  long_description text
  course_type_id smallint [not null]
  default_modality_id smallint [not null]
  duration_hours numeric(6,1) [not null]
  duration_weeks smallint
  base_price_pen numeric(12,2) [not null]
  compare_at_price_pen numeric(12,2)
  grants_certificate boolean [not null]
  pdu_hours numeric(6,1)
  autodesk_official boolean [not null]
  featured_on_home boolean [not null]
  min_enrollment integer [not null]
  max_enrollment integer [not null]
  is_published boolean [not null]
  is_active boolean [not null]
  created_at timestamptz [not null]
}

Table cat.knowledge_areas {
  area_id integer [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(120) [not null]
  sort_order integer [not null]
  is_active boolean [not null]
}

Table cat.modalities {
  modality_id smallint [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(80) [not null]
}

Table cfg.app_settings {
  setting_key varchar(80) [not null, pk]
  setting_value text [not null]
  description varchar(200)
  updated_at timestamptz [not null]
  updated_by_user_id integer
}

Table cfg.configuracion_empresa {
  id smallint [not null, pk]
  nombre_empresa varchar(160) [not null]
  ia_habilitada boolean [not null]
  documentos_habilitados boolean [not null]
  slack_habilitado boolean [not null]
  actualizado_en timestamp
}

Table cfg.currencies {
  currency_code char(3) [not null, pk]
  name varchar(40) [not null]
  symbol varchar(8) [not null]
}

Table cfg.document_types {
  document_type_id smallint [not null, pk]
  code varchar(10) [not null, unique]
  name varchar(80) [not null]
  is_for_person boolean [not null]
  is_for_organization boolean [not null]
}

Table cfg.historial_configuracion {
  id_cambio bigint [not null, pk]
  id_usuario integer
  antes jsonb [not null]
  despues jsonb [not null]
  creado_en timestamp [not null]
  id_configuracion smallint [not null]
}

Table cfg.holidays {
  holiday_date date [not null, pk]
  name varchar(80) [not null]
}

Table cfg.theme_tokens {
  token_key varchar(40) [not null, pk]
  light_hex char(7) [not null]
  dark_hex char(7) [not null]
  description varchar(120)
}

Table cms.hero_slides {
  slide_id integer [not null, pk]
  badge varchar(80)
  title varchar(200) [not null]
  subtitle varchar(400)
  image_url varchar(400)
  primary_cta varchar(40)
  primary_url varchar(200)
  secondary_cta varchar(40)
  secondary_url varchar(200)
  sort_order integer [not null]
  is_active boolean [not null]
}

Table cms.media_assets {
  asset_id integer [not null, pk]
  file_name varchar(200) [not null]
  url varchar(400) [not null]
  mime_type varchar(80)
  uploaded_at timestamptz [not null]
}

Table cms.pages {
  page_id integer [not null, pk]
  slug varchar(80) [not null, unique]
  title varchar(160) [not null]
  body_html text
  is_published boolean [not null]
}

Table cms.site_stats {
  stat_key varchar(40) [not null, pk]
  label varchar(80) [not null]
  display_value varchar(40) [not null]
  sort_order integer [not null]
}

Table cms.testimonials {
  testimonial_id integer [not null, pk]
  author_name varchar(160) [not null]
  author_title varchar(200)
  quote varchar(800) [not null]
  photo_url varchar(400)
  sort_order integer [not null]
  is_published boolean [not null]
}

Table crm.campaigns {
  campaign_id integer [not null, pk]
  name varchar(160) [not null]
  channel varchar(30) [not null]
  starts_on date
  ends_on date
  budget_pen numeric(12,2)
  course_id integer
  is_active boolean [not null]
}

Table crm.lead_interactions {
  interaction_id bigint [not null, pk]
  lead_id integer [not null]
  user_id integer
  channel varchar(20) [not null]
  happened_at timestamptz [not null]
  summary varchar(400) [not null]
  next_follow_up_on date
}

Table crm.lead_sources {
  source_id smallint [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(80) [not null]
}

Table crm.lead_status_history {
  history_id bigint [not null, pk]
  lead_id integer [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_at timestamptz [not null]
  changed_by_user_id integer
}

Table crm.leads {
  lead_id integer [not null, pk]
  full_name varchar(160) [not null]
  email varchar(160)
  phone varchar(20)
  document_number varchar(20)
  city varchar(80)
  profession varchar(120)
  source_id smallint
  campaign_id integer
  course_id integer
  status varchar(20) [not null]
  assigned_user_id integer
  lost_reason varchar(200)
  created_at timestamptz [not null]
  converted_student_id integer
}

Table docs.documentos {
  id_documento bigint [not null, pk]
  codigo varchar(40) [not null, unique]
  titulo varchar(220) [not null]
  id_tipo_documento smallint [not null]
  id_area_propietaria bigint [not null]
  estado varchar(16) [not null]
  resumen varchar(500)
  contenido text
  enlace_archivo varchar(400)
  version_actual integer [not null]
  vigente_desde date
  vigente_hasta date
  creado_por integer
  creado_en timestamptz
  actualizado_en timestamptz
}

Table docs.tipos_documento {
  id_tipo_documento smallint [not null, pk]
  codigo varchar(20) [not null, unique]
  nombre varchar(80) [not null]
}

Table docs.versiones_documento {
  id_version bigint [not null, pk]
  id_documento bigint [not null]
  numero_version integer [not null]
  contenido text
  enlace_archivo varchar(400)
  motivo_cambio varchar(300)
  creado_por integer
  creado_en timestamptz [not null]
  indexes {
    (id_documento, numero_version) [unique]
  }
}

Table fin.discount_rules {
  discount_rule_id integer [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(120) [not null]
  percent numeric(5,2)
  amount_pen numeric(12,2)
  valid_from date
  valid_to date
  coupon_code varchar(30)
  requires_agreement boolean [not null]
  is_active boolean [not null]
}

Table fin.installments {
  installment_id integer [not null, pk]
  enrollment_id integer [not null]
  sequence_no smallint [not null]
  due_on date [not null]
  amount_pen numeric(12,2) [not null]
  paid_amount_pen numeric(12,2) [not null]
  status varchar(16) [not null]
  indexes {
    (enrollment_id, sequence_no) [unique]
  }
}

Table fin.invoice_items {
  invoice_item_id integer [not null, pk]
  invoice_id integer [not null]
  description varchar(220) [not null]
  quantity numeric(8,2) [not null]
  unit_price numeric(12,2) [not null]
  discount_pen numeric(12,2) [not null]
  line_total numeric(12,2) [not null]
}

Table fin.invoices {
  invoice_id integer [not null, pk]
  invoice_type char(2) [not null]
  series varchar(4) [not null]
  number integer [not null]
  enrollment_id integer
  organization_id integer
  student_id integer
  issue_date date [not null]
  currency_code char(3) [not null]
  subtotal numeric(12,2) [not null]
  igv numeric(12,2) [not null]
  total numeric(12,2) [not null]
  status varchar(16) [not null]
  sunat_status varchar(20)
  notes varchar(300)
  created_at timestamptz [not null]
  indexes {
    (invoice_type, series, number) [unique]
  }
}

Table fin.payment_methods {
  payment_method_id smallint [not null, pk]
  code varchar(20) [not null, unique]
  name varchar(80) [not null]
  is_active boolean [not null]
}

Table fin.payments {
  payment_id integer [not null, pk]
  invoice_id integer [not null]
  payment_method_id smallint [not null]
  paid_at timestamptz [not null]
  amount_pen numeric(12,2) [not null]
  reference varchar(80)
  received_by_user_id integer
  notes varchar(200)
}

Table hr.instructor_areas {
  instructor_id integer [not null]
  area_id integer [not null]
  indexes {
    (instructor_id, area_id) [pk]
  }
}

Table hr.instructors {
  instructor_id integer [not null, pk]
  public_id uuid [not null, unique]
  document_type_id smallint [not null]
  document_number varchar(20) [not null]
  full_name varchar(160) [not null]
  professional_title varchar(160)
  email varchar(160)
  phone varchar(20)
  bio text
  photo_url varchar(400)
  user_id integer
  hourly_rate_pen numeric(10,2)
  is_active boolean [not null]
  indexes {
    (document_type_id, document_number) [unique]
  }
}

Table ntf.outbox {
  outbox_id bigint [not null, pk]
