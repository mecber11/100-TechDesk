  trade_name varchar(200)
  sector varchar(80)
  city varchar(80)
  email varchar(160)
  phone varchar(20)
  show_on_home boolean [not null]
  is_active boolean [not null]
  created_at timestamptz [not null]
}

Table public.cache {
  key varchar(255) [not null, pk]
  value text [not null]
  expiration integer [not null]
}

Table public.cache_locks {
  key varchar(255) [not null, pk]
  owner varchar(255) [not null]
  expiration integer [not null]
}

Table public.failed_jobs {
  id bigint [not null, pk]
  uuid varchar(255) [not null, unique]
  connection text [not null]
  queue text [not null]
  payload text [not null]
  exception text [not null]
  failed_at timestamp [not null]
}

Table public.job_batches {
  id varchar(255) [not null, pk]
  name varchar(255) [not null]
  total_jobs integer [not null]
  pending_jobs integer [not null]
  failed_jobs integer [not null]
  failed_job_ids text [not null]
  options text
  cancelled_at integer
  created_at integer [not null]
  finished_at integer
}

Table public.jobs {
  id bigint [not null, pk]
  queue varchar(255) [not null]
  payload text [not null]
  attempts smallint [not null]
  reserved_at integer
  available_at integer [not null]
  created_at integer [not null]
}

Table public.migrations {
  id integer [not null, pk]
  migration varchar(255) [not null]
  batch integer [not null]
}

Table public.model_has_permissions {
  permission_id bigint [not null]
  model_type varchar(255) [not null]
  model_id bigint [not null]
  indexes {
    (permission_id, model_id, model_type) [pk]
  }
}

Table public.model_has_roles {
  role_id bigint [not null]
  model_type varchar(255) [not null]
  model_id bigint [not null]
  indexes {
    (role_id, model_id, model_type) [pk]
  }
}

Table public.password_reset_tokens {
  email varchar(255) [not null, pk]
  token varchar(255) [not null]
  created_at timestamp
}

Table public.permissions {
  id bigint [not null, pk]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (name, guard_name) [unique]
  }
}

Table public.role_has_permissions {
  permission_id bigint [not null]
  role_id bigint [not null]
  indexes {
    (permission_id, role_id) [pk]
  }
}

Table public.roles {
  id bigint [not null, pk]
  name varchar(255) [not null]
  guard_name varchar(255) [not null]
  created_at timestamp
  updated_at timestamp
  indexes {
    (name, guard_name) [unique]
  }
}

Table public.sessions {
  id varchar(255) [not null, pk]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload text [not null]
  last_activity integer [not null]
}

Table public.users {
  id bigint [not null, pk]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  email_verified_at timestamp
  password varchar(255) [not null]
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
  status varchar(255) [not null]
  requested_area varchar(255)
}

Table qms.complaint_history {
  history_id bigint [not null, pk]
  complaint_id integer [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_at timestamptz [not null]
  changed_by_user_id integer
  note varchar(400)
}

Table qms.complaints {
  complaint_id integer [not null, pk]
  ticket_code varchar(20) [not null, unique]
  kind varchar(16) [not null]
  consumer_name varchar(160) [not null]
  document_number varchar(20)
  email varchar(160)
  phone varchar(20)
  address varchar(200)
  good_description varchar(300) [not null]
  claimed_amount_pen numeric(12,2)
  detail text [not null]
  occurred_on date
  enrollment_id integer
  status varchar(20) [not null]
  answer text
  answered_at timestamptz
  due_at date
  created_at timestamptz [not null]
}

Table qms.survey_answers {
  answer_id integer [not null, pk]
  response_id integer [not null]
  question_id integer [not null]
  numeric_value numeric(5,2)
  text_value varchar(500)
}

Table qms.survey_questions {
  question_id integer [not null, pk]
  survey_id integer [not null]
  sort_order integer [not null]
  prompt varchar(300) [not null]
  kind varchar(16) [not null]
}

Table qms.survey_responses {
  response_id integer [not null, pk]
  survey_id integer [not null]
  enrollment_id integer
  instructor_id integer
  submitted_at timestamptz [not null]
}

Table qms.surveys {
  survey_id integer [not null, pk]
  name varchar(160) [not null]
  scope varchar(20) [not null]
  is_active boolean [not null]
}

Table req.adjuntos_pedido {
  id_adjunto bigint [not null, pk]
  id_pedido bigint [not null]
  id_historial bigint
  cargado_por integer
  origen_archivo varchar(20) [not null]
  nombre_original varchar(255) [not null]
  tipo_archivo varchar(120)
  tamano_bytes bigint
  disco varchar(40)
  ruta varchar(500)
  enlace_externo varchar(1000)
  creado_en timestamptz [not null]
}

Table req.avisos_slack {
  id_aviso bigint [not null, pk]
  id_pedido bigint [not null]
  id_area_destino bigint [not null]
  evento varchar(40) [not null]
  estado varchar(20) [not null]
  slack_destinatario varchar(30)
  error varchar(250)
  intentos integer [not null]
  reintentar_en timestamp
  bloqueado_hasta timestamp
  enviado_en timestamp
  creado_en timestamp [not null]
  indexes {
    (id_pedido, evento) [unique]
  }
}

Table req.detalles_pedido {
  id_detalle bigint [not null, pk]
  id_pedido bigint [not null]
  descripcion varchar(220) [not null]
  cantidad numeric(10,2)
  unidad varchar(20)
  notas varchar(200)
}

Table req.historial_pedido {
  id_historial bigint [not null, pk]
  id_pedido bigint [not null]
  estado varchar(255) [not null]
  observacion text
  modificado_por bigint
  modificado_en timestamp [not null]
  estado_anterior varchar(20)
  estado_nuevo varchar(20)
}

Table req.pedidos {
  id_pedido bigint [not null, pk]
  area_origen bigint [not null]
  area_destino bigint [not null]
  solicitado_por bigint
  documento_relacionado bigint
  titulo varchar(200) [not null]
  descripcion text [not null]
  categoria varchar(255)
  prioridad varchar(255)
  estado varchar(255) [not null]
  fecha_limite date
  creado_en timestamp
  actualizado_en timestamp
  codigo_pedido varchar(30) [unique]
  tipo_solicitud varchar(16) [not null]
  respuesta varchar(500)
  atendido_por integer
  motivo_escalamiento varchar(500)
  fecha_escalamiento timestamptz
  fecha_atencion timestamptz
  fecha_cierre timestamptz
  nombre_solicitante text
  correo_solicitante text
}

Table sec.intentos_login {
  id_intento bigint [not null, pk]
  correo citext [not null]
  exitoso boolean [not null]
  direccion_ip varchar(45)
  realizado_en timestamptz [not null]
  id_usuario integer
}

Table sec.permisos {
  id_permiso integer [not null, pk]
  codigo varchar(80) [not null, unique]
  modulo varchar(40) [not null]
  descripcion varchar(200)
}

Table sec.roles {
  id_rol integer [not null, pk]
  nombre varchar(60) [not null, unique]
  descripcion varchar(200)
  es_sistema boolean [not null]
  activo boolean [not null]
}

Table sec.roles_permisos {
  id_rol integer [not null]
  id_permiso integer [not null]
  indexes {
    (id_rol, id_permiso) [pk]
  }
}

Table sec.sesiones_usuario {
  id_sesion uuid [not null, pk]
  id_usuario integer [not null]
  inicio timestamptz [not null]
  fin timestamptz
  direccion_ip varchar(45)
  agente_usuario varchar(300)
}

Table sec.tokens_acceso {
  id_token bigint [not null, pk]
  id_usuario integer [not null]
  hash_token char(64) [not null]
  expira_en timestamptz [not null]
  revocado_en timestamptz
  creado_en timestamptz [not null]
}

Table sec.usuarios {
  id_usuario integer [not null, pk]
  correo citext [not null, unique]
  contrasena varchar(256) [not null]
  nombre_completo varchar(160) [not null]
  telefono varchar(20)
  tema_preferido varchar(10) [not null]
  activo boolean [not null]
  cambiar_contrasena boolean [not null]
  ultimo_ingreso timestamptz
  creado_en timestamptz [not null]
  creado_por integer
  estado varchar(255) [not null]
  area_solicitada varchar(255)
  id_area bigint
  suspendido_en timestamp
  slack_user_id varchar(30) [unique]
}

Table sec.usuarios_roles {
  id_usuario integer [not null]
  id_rol integer [not null]
  asignado_en timestamptz [not null]
  indexes {
    (id_usuario, id_rol) [pk]
  }
}

Table shop.cart_items {
  cart_item_id integer [not null, pk]
  cart_id uuid [not null]
  edition_id integer [not null]
  quantity smallint [not null]
}

Table shop.carts {
  cart_id uuid [not null, pk]
  student_id integer
  session_key varchar(64)
  created_at timestamptz [not null]
}

Table shop.web_order_items {
  order_item_id integer [not null, pk]
  order_id integer [not null]
  edition_id integer [not null]
  enrollment_id integer
  unit_price_pen numeric(12,2) [not null]
}

Table shop.web_orders {
  order_id integer [not null, pk]
  order_code varchar(30) [not null, unique]
  student_id integer [not null]
  status varchar(20) [not null]
  coupon_code varchar(30)
  subtotal_pen numeric(12,2) [not null]
  discount_pen numeric(12,2) [not null]
  total_pen numeric(12,2) [not null]
  created_at timestamptz [not null]
  paid_at timestamptz
}

