      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tomar_di" bpmnElement="tomar">
        <dc:Bounds x="705.0" y="193.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision">
        <dc:Bounds x="1012.5" y="193.0" width="80" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="resolver_di" bpmnElement="resolver">
        <dc:Bounds x="1195.0" y="143.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalar_di" bpmnElement="escalar">
        <dc:Bounds x="1195.0" y="248.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_ti_di" bpmnElement="fin_ti">
        <dc:Bounds x="1513.5" y="154.0" width="58" height="58" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="super_di" bpmnElement="super">
        <dc:Bounds x="1440.0" y="424.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_super_di" bpmnElement="fin_super">
        <dc:Bounds x="1758.5" y="435.0" width="58" height="58" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="346.5" y="233.0" />
        <di:waypoint x="403.25" y="233.0" />
        <di:waypoint x="403.25" y="233.0" />
        <di:waypoint x="460.0" y="233.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="665.0" y="233.0" />
        <di:waypoint x="685.0" y="233.0" />
        <di:waypoint x="685.0" y="233.0" />
        <di:waypoint x="705.0" y="233.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="910.0" y="233.0" />
