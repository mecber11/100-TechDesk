        <di:waypoint x="1195.0" y="288.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1400.0" y="183.0" />
