        <di:waypoint x="1440.0" y="464.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1645.0" y="464.0" />
