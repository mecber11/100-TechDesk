<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_05_tecnologia_ti" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_05_tecnologia_ti" name="Proceso del área de Tecnología TI" isExecutable="false">
    <bpmn:laneSet id="LaneSet_05_tecnologia_ti">
      <bpmn:lane id="Lane_0" name="TI">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tomar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_ti</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SuperAdmin">
        <bpmn:flowNodeRef>super</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_super</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Recibe solicitud de área">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="revisar" name="Revisa prioridad y categoría">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="tomar" name="Asume atención">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="decision" name="¿Puede resolver?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="resolver" name="Atiende o rechaza con nota">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="escalar" name="Escala con motivo">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_ti" name="Atención registrada">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="super" name="Resuelve el escalamiento">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_super" name="Escalamiento resuelto">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="revisar" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="revisar" targetRef="tomar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="tomar" targetRef="decision" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="decision" targetRef="resolver" name="Sí" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="decision" targetRef="escalar" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="resolver" targetRef="fin_ti" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="escalar" targetRef="super" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="super" targetRef="fin_super" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_05_tecnologia_ti">
    <bpmndi:BPMNPlane id="Plane_05_tecnologia_ti" bpmnElement="Process_05_tecnologia_ti">
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="20" y="145" width="1930" height="176" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="20" y="321" width="1930" height="176" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="288.5" y="204.0" width="58" height="58" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revisar_di" bpmnElement="revisar">
