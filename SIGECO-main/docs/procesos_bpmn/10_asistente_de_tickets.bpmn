<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_10_asistente_de_tickets" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_10_asistente_de_tickets" name="Asistencia para crear y clasificar tickets" isExecutable="false">
    <bpmn:laneSet id="LaneSet_10_asistente_de_tickets">
      <bpmn:lane id="Lane_0" name="Área solicitante">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>analizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>proponer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Área destinataria">
        <bpmn:flowNodeRef>recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Describe una necesidad">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="analizar" name="Analiza términos y funciones">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="proponer" name="Propone campos y destino">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="revisar" name="Revisa y ajusta la propuesta">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="enviar" name="Confirma el envío">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="registrar" name="Registra y asigna código">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="recibir" name="Recibe el ticket">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Ticket enviado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="analizar" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="analizar" targetRef="proponer" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="proponer" targetRef="revisar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="revisar" targetRef="enviar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="enviar" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="registrar" targetRef="recibir" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="recibir" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_10_asistente_de_tickets">
    <bpmndi:BPMNPlane id="Plane_10_asistente_de_tickets" bpmnElement="Process_10_asistente_de_tickets">
