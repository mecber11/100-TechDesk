<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_09_ti_envia_pedidos_a_areas" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_09_ti_envia_pedidos_a_areas" name="Pedidos de TI hacia las áreas" isExecutable="false">
    <bpmn:laneSet id="LaneSet_09_ti_envia_pedidos_a_areas">
      <bpmn:lane id="Lane_0" name="TI">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>elegir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>historial</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Área destinataria">
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atender</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="TI necesita apoyo de un área">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="elegir" name="Selecciona área de destino">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="crear" name="Registra pedido y prioridad">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="entregar" name="Asigna código y entrega pedido">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="revisar" name="Revisa pedido recibido">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="atender" name="Atiende o rechaza con nota">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="historial" name="Guarda respuesta e historial">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cerrar" name="Revisa respuesta y cierra">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Pedido cerrado">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="elegir" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="elegir" targetRef="crear" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="crear" targetRef="entregar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="entregar" targetRef="revisar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="revisar" targetRef="atender" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="atender" targetRef="historial" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="historial" targetRef="cerrar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="cerrar" targetRef="fin" />
  </bpmn:process>
