<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01_coordinacion_entre_areas" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_01_coordinacion_entre_areas" name="Coordinación operativa entre áreas" isExecutable="false">
    <bpmn:laneSet id="LaneSet_01_coordinacion_entre_areas">
      <bpmn:lane id="Lane_0" name="Área solicitante">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>ruta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Área destinataria">
        <bpmn:flowNodeRef>analisis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resolver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Surge necesidad interna">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pedido" name="Registra pedido o ticket">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ruta" name="Asigna código y deriva al destino">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="analisis" name="Analiza y toma el caso">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="resolver" name="Registra atención y evidencia">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="verificar" name="Revisa resultado e historial">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cerrar" name="Confirma cierre">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Caso cerrado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="pedido" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="pedido" targetRef="ruta" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ruta" targetRef="analisis" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="analisis" targetRef="resolver" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="resolver" targetRef="verificar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="verificar" targetRef="cerrar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="cerrar" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_01_coordinacion_entre_areas">
    <bpmndi:BPMNPlane id="Plane_01_coordinacion_entre_areas" bpmnElement="Process_01_coordinacion_entre_areas">
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="20" y="145" width="2175" height="176" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="20" y="321" width="2175" height="176" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="20" y="497" width="2175" height="176" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="288.5" y="204.0" width="58" height="58" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pedido_di" bpmnElement="pedido">
        <dc:Bounds x="460.0" y="193.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ruta_di" bpmnElement="ruta">
        <dc:Bounds x="705.0" y="369.0" width="205" height="80" />
