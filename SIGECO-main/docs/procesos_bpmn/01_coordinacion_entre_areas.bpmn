      <bpmndi:BPMNShape id="analisis_di" bpmnElement="analisis">
        <dc:Bounds x="950.0" y="545.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="resolver_di" bpmnElement="resolver">
        <dc:Bounds x="1195.0" y="545.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verificar_di" bpmnElement="verificar">
        <dc:Bounds x="1440.0" y="193.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cerrar_di" bpmnElement="cerrar">
        <dc:Bounds x="1685.0" y="193.0" width="205" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="2003.5" y="204.0" width="58" height="58" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="346.5" y="233.0" />
        <di:waypoint x="403.25" y="233.0" />
        <di:waypoint x="403.25" y="233.0" />
        <di:waypoint x="460.0" y="233.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="665.0" y="233.0" />
        <di:waypoint x="685.0" y="233.0" />
        <di:waypoint x="685.0" y="409.0" />
        <di:waypoint x="705.0" y="409.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="910.0" y="409.0" />
        <di:waypoint x="930.0" y="409.0" />
        <di:waypoint x="930.0" y="585.0" />
