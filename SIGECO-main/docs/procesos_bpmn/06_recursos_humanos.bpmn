<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_06_recursos_humanos" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_06_recursos_humanos" name="Proceso del área de Recursos Humanos" isExecutable="false">
    <bpmn:laneSet id="LaneSet_06_recursos_humanos">
      <bpmn:lane id="Lane_0" name="Recursos Humanos">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rechazar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>activar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>denegar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin_no</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Recibe solicitud de ingreso">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="pendiente" name="Muestra cuenta pendiente del área">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="revisar" name="Revisa datos y pertenencia">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="decision" name="¿Corresponde aprobar?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="aprobar" name="Aprueba acceso al equipo">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="rechazar" name="Rechaza la solicitud">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="activar" name="Activa cuenta del área">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="denegar" name="Mantiene acceso denegado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin_ok" name="Cuenta aprobada">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="fin_no" name="Cuenta rechazada">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="pendiente" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="pendiente" targetRef="revisar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="revisar" targetRef="decision" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="decision" targetRef="aprobar" name="Sí" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="decision" targetRef="rechazar" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="aprobar" targetRef="activar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="rechazar" targetRef="denegar" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="activar" targetRef="fin_ok" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="denegar" targetRef="fin_no" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_06_recursos_humanos">
    <bpmndi:BPMNPlane id="Plane_06_recursos_humanos" bpmnElement="Process_06_recursos_humanos">
