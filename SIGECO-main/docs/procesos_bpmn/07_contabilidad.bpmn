<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_07_contabilidad" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_07_contabilidad" name="Proceso del área de Contabilidad" isExecutable="false">
    <bpmn:laneSet id="LaneSet_07_contabilidad">
      <bpmn:lane id="Lane_0" name="Contabilidad">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>requisito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>comprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>derivar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="TI">
        <bpmn:flowNodeRef>atender</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Identifica necesidad interna">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="requisito" name="Define documento o software">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ticket" name="Registra solicitud y prioridad">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="derivar" name="Dirige a TI">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="atender" name="Atiende y registra respuesta">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="comprobar" name="Comprueba resultado">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cerrar" name="Confirma cierre">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Solicitud cerrada">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="requisito" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="requisito" targetRef="ticket" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ticket" targetRef="derivar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="derivar" targetRef="atender" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="atender" targetRef="comprobar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="comprobar" targetRef="cerrar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="cerrar" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_07_contabilidad">
    <bpmndi:BPMNPlane id="Plane_07_contabilidad" bpmnElement="Process_07_contabilidad">
