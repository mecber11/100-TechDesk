<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_04_marketing" targetNamespace="https://nexusadmin.local/bpmn" exporter="SIGECO BPMN 2.0">
  <bpmn:process id="Process_04_marketing" name="Proceso del área de Marketing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_04_marketing">
      <bpmn:lane id="Lane_0" name="Marketing">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detalle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="SIGECO">
        <bpmn:flowNodeRef>derivar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="TI">
        <bpmn:flowNodeRef>atender</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Identifica necesidad del área">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="detalle" name="Precisa software o servicio">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="registrar" name="Crea solicitud con contexto">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="derivar" name="Deriva a la bandeja TI">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="atender" name="Registra solución y evidencia">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="validar" name="Valida la solución">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cerrar" name="Cierra la solicitud">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fin" name="Requerimiento cerrado">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="inicio" targetRef="detalle" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="detalle" targetRef="registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="registrar" targetRef="derivar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="derivar" targetRef="atender" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="atender" targetRef="validar" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="validar" targetRef="cerrar" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="cerrar" targetRef="fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_04_marketing">
    <bpmndi:BPMNPlane id="Plane_04_marketing" bpmnElement="Process_04_marketing">
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
